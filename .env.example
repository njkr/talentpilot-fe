# Copy to .env.local and adjust. Never commit real values.

# Base URL the browser uses for API calls. "/api/v1" goes through this app's own
# origin (see proxy.ts), which keeps the refresh cookie first-party.
# Use the backend's full URL (e.g. http://localhost:3000/api/v1) to call it directly.
NEXT_PUBLIC_API_URL=/api/v1

# Canonical public URL of this site (metadata, sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only. Origin of the backend that proxy.ts forwards /api/v1/* to.
# No trailing slash and no /api/v1 suffix. If unset, no proxying happens.
BACKEND_API_ORIGIN=http://localhost:3000
